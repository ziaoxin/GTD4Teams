# ============================================================
# GTD4Teams 部署配置模板
#
# 用法：复制成项目根目录的 .env（docker compose 会自动读取）
#   cp deploy/env.example .env
#
# 首次部署（deploy/install.sh）会自动完成这个复制。
# 注意：install.sh **不再生成注册口令** —— 自助注册已随 CR-2026-001 下线，账号只能由管理员创建。
#
# 注意：.env 含密钥，已被 .gitignore 与 .dockerignore 排除，
#       不会进版本库，也不会被打进镜像。
# ============================================================

# ---- 公网入口 ----
# Caddy 是对外唯一入口：HTTP 用于访问（以及自动跳转 HTTPS），HTTPS 用于证书。
GTD_HTTP_PORT=80
GTD_HTTPS_PORT=443

# 域名。填了就有自动 HTTPS；留空则以明文 HTTP 提供（此时登录口令明文过网，仅建议内网）。
# 填之前先确认域名的 A 记录已指向本机公网 IP，否则 Caddy 申请证书会失败。
#GTD_DOMAIN=gtd.example.com

# ---- 槽位端口（只绑 127.0.0.1，不对公网开放）----
# 这两个端口有两个用途：发布脚本对"某个具体槽位"做健康检查与冒烟测试时直连它；
# 排障时你也能直接访问某个槽位，绕开 Caddy 看清到底是哪一层的问题。
# 它们**必须**只绑回环 —— 这是 GTD_TRUST_PROXY=1 能成立的前提之一。
# 只有在宿主机上这两个端口已被占用时才需要改。
GTD_BLUE_PORT=8788
GTD_GREEN_PORT=8789

# ---- 注册策略：**已废弃（CR-2026-001）** ----
# 自助注册端点已从代码移除（`POST /api/auth/register` → 404），因此：
#   · GTD_ALLOW_SIGNUP **无论填 0 还是 1 都不产生任何效果** —— 改它开不出注册，也关不掉注册；
#   · GTD_SIGNUP_CODE 同理，已不需要、也不该轮换。
# 保留这两个键只是为了兼容老 .env：启动横幅与 `server.py --check` 会打印一行
# 「…已随自助注册下线而失效（端点已移除），可以从 .env 里删掉」的提醒
# （见 pyapp/config.py 的 ignored_signup_env）。删掉这两个键也可以，删后重建容器就不再提示。
# 账号现在只能由管理员创建：首任 `python server.py --create-admin <邮箱>`，
# 后续走建号接口或 `--set-password`。
GTD_ALLOW_SIGNUP=0

# 注册口令：已废弃（同上）。历史值可清空或删除整行。
GTD_SIGNUP_CODE=

# ---- 反向代理信任（安全开关）----
# 1 = 信任 Caddy 递来的 X-Forwarded-For / X-Forwarded-Proto。
#
# 这里默认 1（与上一版相反），前提有两个，缺一不可：
#   1. 两个槽位的端口都只绑 127.0.0.1，公网进不来；
#   2. 所有流量都过 Caddy，而 Caddy 会把 XFF **覆盖**为真实客户端 IP（不是追加）。
# 两条同时成立时，登录限流才能按真实 IP 计数。
#
# ⚠️ 如果你把 GTD_BLUE_PORT / GTD_GREEN_PORT 的绑定地址改成 0.0.0.0，
#    必须同时把这里改回 0 —— 否则任何人都能靠伪造 XFF 换掉限流键，爆破等于不限速。
GTD_TRUST_PROXY=1

# ---- 连续性探测的目标路径 ----
# 发布脚本会用这个路径在切换窗口内持续打流，用来证明"没有断线"。
# /api/health 免鉴权、开销极低，是最合适的选择；想更贴近真实用户可改成 /。
# 取值优先级：这里（.env）> 进程环境变量 > 默认 /api/health；两处都有且不同时以 .env 为准（会打提示）。
GTD_PROBE_PATH=/api/health

# ---- 看门狗自动降级（默认关闭）----
# ⚠️ 取消注释即**真的启用**：连续 8 次发现活跃槽位不健康时，会自动切回上一版镜像并改写 deploy/run/state.env。
#   0 = 只写日志告警，等你人工处置（当前默认）；
#   1 = 自动切回上一版镜像（会真的切，不再是摆设 —— 开启前先确认上一版镜像仍在本地）。
# 取值优先级：这里（.env）> 进程环境变量 > 默认 0；两处都有且不同时以 .env 为准（会打提示）。
#GTD_WATCHDOG_FAILOVER=0

# ---- AI 能力（可选，不填则 AI 接口返回 LLM_NOT_CONFIGURED）----
# 任何兼容 OpenAI /chat/completions 的服务都能接：
# OpenAI、DeepSeek、通义、智谱、Kimi，以及自建的 Ollama / vLLM / LM Studio。
# 也可以不在这里配，改为登录后在界面里填写（会存进数据库，同样不下发到浏览器）。
#GTD_LLM_API_KEY=
#GTD_LLM_BASE_URL=https://api.deepseek.com/v1
#GTD_LLM_MODEL=deepseek-chat

# ---- 实例管理员（安全相关，第 1 期新增）----
# 逗号分隔的邮箱白名单，大小写不敏感、容忍空格。
#
# 作用：**只有名单里的人**才能经 HTTP 修改 AI 配置（POST /api/llm/config）。
# 这个接口在第 1 期之前是"任何登录用户都能改"，而 baseUrl 一旦可改，
# 服务端就会把真实的 LLM 密钥以 Authorization: Bearer 发到那个地址 ——
# 等于注册一个号就能把密钥外带出去。
#
# 留空 = **没有人可以经 HTTP 修改**，AI 配置只能走上面的 GTD_LLM_* 环境变量。
# 这是有意的安全默认：宁可默认关闭，也不默认人人可写。
# 需要界面里能改就填上自己：
#GTD_ADMIN_EMAILS=admin@example.com,ops@example.com
