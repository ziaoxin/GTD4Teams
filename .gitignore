# 运行时数据：数据库、预写日志、备份 —— 绝不入库（含口令散列）
data/
*.db
*.db-shm
*.db-wal
backup*.json

# 部署配置：含注册口令与 AI 密钥，绝不能进版本库
.env
.env.local
*.env
!.env.example

# Python
__pycache__/
*.py[cod]

# 部署运行期状态：当前活跃槽位、生成的 Caddy 配置、测试日志
# 这些是**每台机器自己的状态**，必须各自长出来；一旦入库，谁 clone 下来
# 都会继承别人的"当前版本"，发布脚本会据此做出错误判断。
deploy/run/

# 证书与私钥（上面的 deploy/run/ 已经覆盖，这里显式列出，防止将来有人
# 把部署目录挪走而私钥跟着进版本库）。自签名证书由 deploy/gen-selfsigned.sh 生成。
deploy/run/certs/
*.key
*.pem

# 测试临时产物
.smoke/_*.log
.smoke/_*.mjs
.smoke/*.log

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
